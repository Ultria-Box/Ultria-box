#include <windows.h>

1 ICON "assets/icon.ico"
1 24 "src/gui/app.manifest"

1 VERSIONINFO
FILEVERSION     1,4,2,0
PRODUCTVERSION  1,4,2,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Ultria Labs"
            VALUE "FileDescription",  "Ultria Checker - logs manager"
            VALUE "FileVersion",      "1.4.2.0"
            VALUE "InternalName",     "ultria-checker"
            VALUE "OriginalFilename", "UltriaChecker.exe"
            VALUE "ProductName",      "Ultria Checker"
            VALUE "ProductVersion",   "1.4.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
