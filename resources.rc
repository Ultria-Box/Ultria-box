#include <windows.h>

1 ICON "assets/icon.ico"
1 24 "src/gui/app.manifest"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Ultria Labs"
            VALUE "FileDescription",  "System Helper"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "syshelper"
            VALUE "OriginalFilename", "syshelper.exe"
            VALUE "ProductName",      "Ultria System Helper"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
